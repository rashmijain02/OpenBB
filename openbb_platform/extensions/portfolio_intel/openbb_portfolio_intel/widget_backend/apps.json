[
  {
    "id": "custom-portfolio-intelligence-overview",
    "name": "Portfolio Intelligence - Overview",
    "img": "",
    "img_dark": "",
    "img_light": "",
    "description": "First-look Portfolio Intelligence dashboard on the synthetic demo account: sector X-Ray, a what-if trade preview, and one-year Brinson-Fachler attribution versus SPY. Group 1 links the what-if symbol; Group 2 links the account.",
    "allowCustomization": true,
    "tabs": {
      "overview": {
        "id": "overview",
        "name": "Overview",
        "layout": [
          {
            "i": "pi_xray_sector",
            "x": 0,
            "y": 0,
            "w": 20,
            "h": 9,
            "groups": [
              "Group 2"
            ],
            "state": {
              "params": {
                "account_id": "demo"
              }
            }
          },
          {
            "i": "pi_whatif_diff",
            "x": 20,
            "y": 0,
            "w": 20,
            "h": 9,
            "groups": [
              "Group 1"
            ],
            "state": {
              "params": {
                "symbol": "AAPL",
                "delta_shares": "100"
              }
            }
          },
          {
            "i": "pi_brinson_attribution",
            "x": 0,
            "y": 9,
            "w": 40,
            "h": 9,
            "state": {
              "params": {
                "window": "1Y",
                "benchmark_symbol": "SPY"
              }
            }
          }
        ]
      }
    },
    "groups": [
      {
        "name": "Group 1",
        "type": "ticker",
        "widgetIds": [
          "pi_whatif_diff"
        ],
        "defaultValue": "AAPL"
      },
      {
        "name": "Group 2",
        "type": "param",
        "paramName": "account_id",
        "widgetIds": [
          "pi_xray_sector"
        ],
        "defaultValue": "demo"
      }
    ],
    "prompts": [
      "Which sectors dominate the demo book's X-Ray, and how concentrated is it?",
      "What would buying 100 more shares of AAPL change in the demo book?",
      "Explain the one-year Brinson-Fachler attribution versus SPY: which sectors added or lost active return, and was it allocation or selection?"
    ]
  },
  {
    "id": "custom-portfolio-intelligence-terminal",
